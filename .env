# ========================================
# POCKETHEALTH ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ========================================

# Supabase Configuration
# Get these from: https://app.supabase.com/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Edge Function URL (auto-constructed from SUPABASE_URL)
VITE_EDGE_FUNCTION_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/pockethealth-assistant

# ========================================
# SUPABASE SECRETS (Set via CLI, not in .env)
# ========================================
# Run: supabase secrets set OPENAI_API_KEY=your_key_here

# OpenAI API Key (for embeddings and chat)
# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-...

# ========================================
# OPTIONAL CONFIGURATION
# ========================================

# Development mode
VITE_DEV_MODE=true

# Enable debug logging
VITE_DEBUG=false
